{
  "name": "create-gis-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "jsdom": "^31.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
