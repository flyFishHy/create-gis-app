{
  "name": "create-gis-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=12.14.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:quality": "eslint --config eslint.quality.config.js \"packages/*/src/**/*.{js,cjs,mjs,ts,cts,mts,vue}\"",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier \"**/*.{js,cjs,mjs,ts,cts,mts,vue,css,scss,html,json,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{js,cjs,mjs,ts,cts,mts,vue,css,scss,html,json,yml,yaml}\" --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.1",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
