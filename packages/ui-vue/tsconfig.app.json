{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "preserve",
    "outDir": "dist-types",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "references": [{ "path": "../core" }],
  "vueCompilerOptions": {
    "strictTemplates": true
  }
}
