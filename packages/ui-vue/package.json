{
  "name": "@joinmap/ui-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm build:types && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.app.json",
    "clean": "tsc -b tsconfig.app.json tsconfig.node.json --clean"
  },
  "dependencies": {
    "@joinmap/gis-core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.45"
  }
}
